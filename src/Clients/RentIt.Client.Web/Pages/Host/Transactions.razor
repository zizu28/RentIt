@page "/host/transactions"
@using RentIt.Client.Web.Services
@using RentIt.Shared.DTOs.Bookings
@using global::RentIt.Client.Web.Services
@inject IBookingService BookingService
@inject IPaymentService PaymentService
@inject IPropertyService PropertyService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Host")]

<PageTitle>Transactions - RentIt Host</PageTitle>

<div class="page-container animate-fade-in-up">
    <div class="breadcrumbs mb-4">
        <a href="/">Home</a> <span>/</span> 
        <a href="/host/dashboard">Host Dashboard</a> <span>/</span> 
        <span class="active">Transactions</span>
    </div>
    
    <div class="section-header-cc mb-6">
        <div>
            <h1 class="page-title mb-2">Transactions</h1>
            <p class="hero-subtitle m-0">Review all your bookings and payments.</p>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="loading-spinner-container mt-5 text-center">
            <div class="loading-progress">
                <svg><circle cx="64" cy="64" r="56"></circle><circle cx="64" cy="64" r="56"></circle></svg>
            </div>
            <p class="mt-3 text-secondary">Loading transactions...</p>
        </div>
    }
    else if (_allBookings != null && _allBookings.Any())
    {
        <div class="filters mb-4">
            <button class="btn @(string.IsNullOrEmpty(_filterStatus) ? "btn-primary" : "btn-outline") mr-2" @onclick="() => SetFilter(null)">All</button>
            <button class="btn @(_filterStatus == "Pending" ? "btn-primary" : "btn-outline") mr-2" @onclick='() => SetFilter("Pending")'>Pending</button>
            <button class="btn @(_filterStatus == "Confirmed" ? "btn-primary" : "btn-outline") mr-2" @onclick='() => SetFilter("Confirmed")'>Confirmed</button>
            <button class="btn @(_filterStatus == "Cancelled" ? "btn-primary" : "btn-outline") mr-2" @onclick='() => SetFilter("Cancelled")'>Cancelled</button>
            <button class="btn @(_filterStatus == "Refunded" ? "btn-primary" : "btn-outline") mr-2" @onclick='() => SetFilter("Refunded")'>Refunded</button>
        </div>

        <div class="card-glass p-4 table-responsive">
            <table class="table-cc">
                <thead>
                    <tr>
                        <th>Property</th>
                        <th>Dates</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Paystack Ref</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in FilteredBookings)
                    {
                        var payment = _paymentDetails.TryGetValue(booking.Id, out var p) ? p : null;
                        var propertyTitle = _propertyNames.TryGetValue(booking.PropertyId, out var t) ? t : "Unknown Property";
                        
                        <tr class="animate-fade-in-up">
                            <td>
                                <strong>@propertyTitle</strong>
                            </td>
                            <td>
                                @booking.StartDate.ToString("MMM dd, yyyy") - @booking.EndDate.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                <strong>@booking.Currency @booking.TotalPrice.ToString("N2")</strong>
                            </td>
                            <td>
                                @if (booking.Status == "Pending")
                                {
                                    <span class="badge-cc badge-warning">
                                        <i class="bi bi-hourglass-split mr-1"></i> @booking.Status
                                    </span>
                                }
                                else if (booking.Status == "Confirmed" || booking.Status == "Completed")
                                {
                                    <span class="badge-cc badge-success">
                                        <i class="bi bi-check-circle mr-1"></i> @booking.Status
                                    </span>
                                }
                                else if (booking.Status == "Cancelled")
                                {
                                    <span class="badge-cc badge-danger">
                                        <i class="bi bi-x-circle mr-1"></i> @booking.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-cc badge-secondary">
                                        @booking.Status
                                    </span>
                                }
                            </td>
                            <td>
                                @if (payment != null && !string.IsNullOrEmpty(payment.Reference))
                                {
                                    <span class="text-secondary" style="font-family: monospace;">@payment.Reference</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (booking.Status == "Pending")
                                {
                                    <button class="btn-cc-secondary btn-sm text-primary border-primary mr-2" @onclick="() => RemindGuestAsync(booking.Id)">
                                        <i class="bi bi-envelope mr-1"></i> Remind
                                    </button>
                                    <button class="btn-cc-secondary btn-sm text-danger border-danger" @onclick="() => RescindBookingAsync(booking.Id)">
                                        <i class="bi bi-trash mr-1"></i> Rescind
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="hero-section text-center py-5 mt-4 mb-4 card-glass animated-fade-in mx-auto" style="max-width: 800px;">
            <div class="hero-icon-container mb-4">
                <i class="bi bi-receipt display-1 text-secondary"></i>
            </div>
            <h2 class="page-title hero-title mb-4">No transactions found</h2>
            <p class="hero-subtitle mb-6 text-secondary mx-auto" style="max-width: 600px;">
                You currently have no transactions to display.
            </p>
            <button class="btn-cc-secondary" @onclick='() => Navigation.NavigateTo("/host/dashboard")'>
                Back to Dashboard
            </button>
        </div>
    }
</div>

@code {
    private IEnumerable<BookingDto>? _allBookings;
    private string? _filterStatus = null;
    private Dictionary<Guid, PaymentDetailsDto> _paymentDetails = new();
    private Dictionary<Guid, string> _propertyNames = new();
    private bool _isLoading = true;

    private IEnumerable<BookingDto> FilteredBookings => string.IsNullOrEmpty(_filterStatus) 
        ? _allBookings ?? Array.Empty<BookingDto>() 
        : (_allBookings?.Where(b => b.Status == _filterStatus) ?? Array.Empty<BookingDto>());

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private void SetFilter(string? status)
    {
        _filterStatus = status;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _allBookings = await BookingService.GetHostTransactionsAsync();
            
            var properties = await PropertyService.GetHostPropertiesAsync();
            _propertyNames = properties.ToDictionary(p => p.Id, p => p.Title);

            foreach (var booking in _allBookings)
            {
                var payment = await PaymentService.GetPaymentByBookingIdAsync(booking.Id);
                if (payment != null)
                {
                    _paymentDetails[booking.Id] = payment;
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RescindBookingAsync(Guid bookingId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to rescind this pending booking? This will cancel the booking request.");
        if (confirmed)
        {
            try
            {
                await BookingService.RescindBookingAsync(bookingId);
                await LoadDataAsync(); // Reload the data
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Failed to rescind booking: {ex.Message}");
            }
        }
    }

    private async Task RemindGuestAsync(Guid bookingId)
    {
        try
        {
            await BookingService.RemindGuestAsync(bookingId);
            await JSRuntime.InvokeVoidAsync("alert", "Payment reminder sent to the guest successfully.");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to send reminder: {ex.Message}");
        }
    }
}
