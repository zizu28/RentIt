@page "/host/properties/add"
@using RentIt.Shared.DTOs.Properties
@using RentIt.Client.Web.Services
@inject IPropertyService PropertyService
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Add Property - RentIt</PageTitle>

<div class="page-container">
    <div class="breadcrumbs mb-6">
        <a href="/">Home</a> <span>/</span> 
        <a href="/host/dashboard">Host Dashboard</a> <span>/</span> 
        <span class="active">Add Property</span>
    </div>

    <div class="add-property-form-container mx-auto" style="max-width: 800px;">
        <h1 class="page-title mb-8 text-center">List your space on RentIt</h1>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger mb-6">
                <i class="bi bi-exclamation-triangle-fill mr-2"></i> @_errorMessage
            </div>
        }

        <form @onsubmit="HandleSubmitAsync">
            
            <div class="card mb-6" style="margin-bottom: 10px;">
                <div class="card-body">
                    <h3 class="section-title mb-4">Basic Details</h3>
                    
                    <div class="form-group mb-4">
                        <label>Property Name</label>
                        <input type="text" class="form-control" @bind="_request.Name" placeholder="e.g. Cozy Downtown Loft" required />
                    </div>

                    <div class="form-group mb-4">
                        <label>Description</label>
                        <textarea class="form-control" rows="4" @bind="_request.Description" placeholder="Describe your property..." required></textarea>
                    </div>
                </div>
            </div>

            <div class="card mb-6" style="margin-bottom: 10px;">
                <div class="card-body">
                    <h3 class="section-title mb-4">Location</h3>
                    
                    <div class="form-group mb-4">
                        <label>Street Address</label>
                        <input type="text" class="form-control" @bind="_request.Street" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-4">
                            <label>Region/State</label>
                            <select class="form-select form-control" @bind="_request.Region" @bind:after="OnRegionChanged" required>
                                <option value="" disabled selected>Select Region...</option>
                                @foreach (var region in _ghanaRegions.Keys)
                                {
                                    <option value="@region">@region</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 form-group mb-4">
                            <label>City</label>
                            <select class="form-select form-control" @bind="_request.City" disabled="@string.IsNullOrEmpty(_request.Region)" required>
                                <option value="" disabled selected>Select City...</option>
                                @if (!string.IsNullOrEmpty(_request.Region) && _ghanaRegions.ContainsKey(_request.Region))
                                {
                                    @foreach (var city in _ghanaRegions[_request.Region])
                                    {
                                        <option value="@city">@city</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-4">
                            <label>Country</label>
                            <input type="text" class="form-control" @bind="_request.Country" required />
                        </div>
                        <div class="col-md-6 form-group mb-4">
                            <label>Postal Code</label>
                            <input type="text" class="form-control" @bind="_request.PostalCode" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-6" style="margin-bottom: 10px;">
                <div class="card-body">
                    <h3 class="section-title mb-4">Features & Pricing</h3>
                    
                    <div class="row">
                        <div class="col-md-4 form-group mb-4">
                            <label>Property Type</label>
                            <select class="form-select form-control" @bind="_request.Type" @bind:after="OnPropertyTypeChanged" required>
                                @foreach (var type in _propertyTypes)
                                {
                                    <option value="@type.Key">@type.Value</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 form-group mb-4">
                            <label>Rental Duration</label>
                            @if (_request.Type == 1 || _request.Type == 2)
                            {
                                <select class="form-select form-control" @bind="_request.RentalPeriod" required>
                                    <option value="2">Monthly</option>
                                    <option value="3">Yearly</option>
                                </select>
                            }
                            else
                            {
                                <input type="text" class="form-control" value="@GetRentalPeriodText(_request.RentalPeriod)" disabled />
                            }
                        </div>
                        <div class="col-md-4 form-group mb-4">
                            <label>Status</label>
                            <select class="form-select form-control" @bind="_request.Status" required>
                                <option value="1">Draft</option>
                                <option value="2">Available</option>
                                <option value="5">Unlisted</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 form-group mb-4">
                            <label>Price (@GetPriceSuffix(_request.RentalPeriod))</label>
                            <input type="number" step="0.01" min="1" class="form-control" @bind="_request.PricePerPeriod" required />
                        </div>
                        <div class="col-md-4 form-group mb-4">
                            <label>Bedrooms</label>
                            <input type="number" class="form-control" min="1" @bind="_request.Bedrooms" required />
                        </div>
                        <div class="col-md-4 form-group mb-4">
                            <label>Bathrooms</label>
                            <input type="number" class="form-control" min="1" @bind="_request.Bathrooms" required />
                        </div>
                        <div class="col-md-4 form-group mb-4">
                            <label>Security Deposit (GHS)</label>
                            <input type="number" step="0.01" min="0" class="form-control" @bind="_request.SecurityDeposit" required />
                        </div>
                    </div>
                    
                    <div class="form-group mb-4">
                        <label>Amenities (comma separated)</label>
                        <input type="text" class="form-control" @bind="_amenitiesInput" placeholder="Wifi, Pool, Kitchen..." />
                    </div>
                    
                    <div class="form-group mb-4">
                        <label>Images</label>
                        <div class="image-upload-area p-5 text-center border rounded bg-light">
                            <i class="bi bi-cloud-arrow-up display-4 text-secondary mb-3"></i>
                            <p class="mb-0 text-secondary">Upload images for your property.</p>
                            <InputFile class="form-control mt-3" multiple OnChange="HandleFileSelection" accept="image/png, image/jpeg" />
                            @if (_selectedFiles.Count > 0)
                            {
                                <small class="text-success mt-2 d-block">@_selectedFiles.Count files selected</small>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mb-8">
                <button type="button" class="btn btn-outline mr-4" @onclick='() => Navigation.NavigateTo("/host/dashboard")'>Cancel</button>
                <button type="submit" class="btn btn-primary px-5" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner mr-2"></span> <span>Saving...</span>
                    }
                    else
                    {
                        <span>List Property</span>
                    }
                </button>
            </div>
        </form>
    </div>
</div>

@code {
    private bool _isSubmitting = false;
    private string _errorMessage = string.Empty;
    private string _amenitiesInput = string.Empty;
    
    private readonly Dictionary<string, List<string>> _ghanaRegions = new()
    {
        { "Ahafo", new List<string> { "Goaso", "Hwidiem", "Kenyasi", "Kukuom" } },
        { "Ashanti", new List<string> { "Kumasi", "Obuasi", "Ejura", "Mampong" } },
        { "Bono", new List<string> { "Sunyani", "Berekum", "Dormaa Ahenkro", "Wenchi" } },
        { "Bono East", new List<string> { "Techiman", "Kintampo", "Nkoranza", "Atebubu" } },
        { "Central", new List<string> { "Cape Coast", "Winneba", "Kasoa", "Elmina" } },
        { "Eastern", new List<string> { "Koforidua", "Nkawkaw", "Nsawam", "Suhum" } },
        { "Greater Accra", new List<string> { "Accra", "Tema", "Madina", "Ashaiman", "Osu", "Legon" } },
        { "North East", new List<string> { "Nalerigu", "Walewale", "Gambaga", "Bunkpurugu" } },
        { "Northern", new List<string> { "Tamale", "Yendi", "Savelugu", "Bimbilla" } },
        { "Oti", new List<string> { "Dambai", "Jasikan", "Kadjebi", "Nkwanta" } },
        { "Savannah", new List<string> { "Damongo", "Bole", "Salaga", "Sawla" } },
        { "Upper East", new List<string> { "Bolgatanga", "Navrongo", "Bawku", "Paga" } },
        { "Upper West", new List<string> { "Wa", "Tumu", "Lawra", "Nandom" } },
        { "Volta", new List<string> { "Ho", "Hohoe", "Keta", "Aflao" } },
        { "Western", new List<string> { "Sekondi-Takoradi", "Tarkwa", "Axim", "Elubo" } },
        { "Western North", new List<string> { "Sefwi Wiawso", "Bibiani", "Enchi", "Bodi" } }
    };

    private readonly Dictionary<int, string> _propertyTypes = new()
    {
        { 1, "Apartment" },
        { 2, "House" },
        { 3, "Villa" },
        { 4, "Guesthouse" },
        { 5, "Commercial" },
        { 6, "Single Room" },
        { 7, "Compound House" }
    };

    // Using a simple model to back the form before mapping to CreatePropertyRequest
    private FormModel _request = new();
    private List<Microsoft.AspNetCore.Components.Forms.IBrowserFile> _selectedFiles = new();

    private void OnRegionChanged()
    {
        _request.City = string.Empty;
    }

    private void OnPropertyTypeChanged()
    {
        // 1 = Nightly, 2 = Monthly, 3 = Yearly
        if (_request.Type == 4 || _request.Type == 3) // Guesthouse or Villa
        {
            _request.RentalPeriod = 1; // Nightly
        }
        else if (_request.Type == 1 || _request.Type == 2) // Apartment or House
        {
            _request.RentalPeriod = 2; // Default to Monthly
        }
        else // Commercial, SingleRoom, CompoundHouse
        {
            _request.RentalPeriod = 3; // Yearly
        }
    }

    private string GetRentalPeriodText(int period) => period switch
    {
        1 => "Nightly",
        2 => "Monthly",
        3 => "Yearly",
        _ => ""
    };

    private string GetPriceSuffix(int period) => period switch
    {
        1 => "per night",
        2 => "per month",
        3 => "per year",
        _ => "GHS"
    };

    private void HandleFileSelection(InputFileChangeEventArgs e)
    {
        _selectedFiles.Clear();
        foreach (var file in e.GetMultipleFiles())
        {
            _selectedFiles.Add(file);
        }
    }

    private class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Street { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Region { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
        public string PostalCode { get; set; } = string.Empty;
        public int Type { get; set; } = 1;
        public int Status { get; set; }
        public int RentalPeriod { get; set; } = 2;
        public int Bedrooms { get; set; } = 1;
        public int Bathrooms { get; set; } = 1;
        public decimal PricePerPeriod { get; set; } = 50.00m;
        public decimal SecurityDeposit { get; set; } = 0.00m;
    }

    private async Task HandleSubmitAsync()
    {
        _errorMessage = string.Empty;
        _isSubmitting = true;

        try
        {
            var amenities = _amenitiesInput.Split(',')
                                           .Select(a => a.Trim())
                                           .Where(a => !string.IsNullOrEmpty(a))
                                           .ToList();
                                           
            var request = new CreatePropertyRequest(
                _request.Name,
                _request.Description,
                _request.Street,
                _request.City,
                _request.Region,
                _request.Country,
                _request.PostalCode,
                _request.Type,
                _request.RentalPeriod,
                _request.PricePerPeriod,
                _request.SecurityDeposit,
                _request.Bedrooms,
                _request.Bathrooms,
                amenities,
                Enumerable.Empty<string>(),
                _request.Status
            );

            await PropertyService.CreatePropertyAsync(request, _selectedFiles);
            
            Navigation.NavigateTo("/host/dashboard");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to create property: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
