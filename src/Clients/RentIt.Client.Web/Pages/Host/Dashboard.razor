@page "/host/dashboard"
@using RentIt.Shared.DTOs.Properties
@using RentIt.Client.Web.Services
@inject IPropertyService PropertyService
@inject IBookingService BookingService
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Host Dashboard - RentIt</PageTitle>

<div class="page-container animate-fade-in-up">
    <div class="breadcrumbs mb-4">
        <a href="/">Home</a> <span>/</span> 
        <a href="/profile">Profile</a> <span>/</span> 
        <span class="active">Host Dashboard</span>
    </div>
    
    <div class="section-header-cc mb-6">
        <div>
            <h1 class="page-title mb-2">Host Overview</h1>
            <p class="hero-subtitle m-0">Manage your listings, track earnings, and host with confidence.</p>
        </div>
        @if (_properties != null && _properties.Any())
        {
            <button class="btn-cc-primary" @onclick='() => Navigation.NavigateTo("/host/properties/add")'>
                <i class="bi bi-plus-lg"></i> Add New Listing
            </button>
        }
    </div>

    @if (_isLoading)
    {
        <div class="loading-spinner-container mt-5 text-center">
            <div class="loading-progress">
                <svg><circle cx="64" cy="64" r="56"></circle><circle cx="64" cy="64" r="56"></circle></svg>
            </div>
            <p class="mt-3 text-secondary">Loading your properties...</p>
        </div>
    }
    else if (_properties != null && _properties.Any())
    {
        <div class="dashboard-stats mb-8 stagger-children">
            <div class="stat-card-cc animate-fade-in-up">
                <div class="d-flex align-items-center">
                    <div class="stat-icon-cc text-info">
                        <i class="bi bi-house-door"></i>
                    </div>
                    <div class="stat-details-cc ml-4">
                        <p class="stat-title-cc">Total Listings</p>
                        <h3 class="stat-value-cc">@_properties.Count()</h3>
                    </div>
                </div>
            </div>
            <div class="stat-card-cc animate-fade-in-up">
                <div class="d-flex align-items-center">
                    <div class="stat-icon-cc text-warning">
                        <i class="bi bi-star"></i>
                    </div>
                    <div class="stat-details-cc ml-4">
                        <p class="stat-title-cc">Average Rating</p>
                        <h3 class="stat-value-cc">@(_properties.Average(p => p.Rating).ToString("0.0"))</h3>
                    </div>
                </div>
            </div>
            <div class="stat-card-cc animate-fade-in-up">
                <div class="d-flex align-items-center">
                    <div class="stat-icon-cc text-success">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div class="stat-details-cc ml-4">
                        <p class="stat-title-cc">Est. Monthly Earnings</p>
                        <h3 class="stat-value-cc">GHS @CalculateMonthlyEarnings(_properties).ToString("N2")</h3>
                    </div>
                </div>
            </div>
        </div>

        <h2 class="section-title mb-4">Your Properties</h2>
        <div class="properties-grid stagger-children">
            @foreach (var property in _properties)
            {
                <div class="card-glass property-card animate-fade-in-up" @onclick="@(() => Navigation.NavigateTo($"/properties/{property.Id}"))">
                    <div class="property-img-wrapper">
                        <img src="@(property.ImageUrls.FirstOrDefault() ?? "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80&w=800")" alt="@property.Title" class="property-img" />
                        <div class="badge-cc @GetStatusBadgeClass(property.Status) property-badge">@GetStatusText(property.Status)</div>
                    </div>
                    <div class="property-content p-4">
                        <div class="property-header d-flex justify-content-between align-items-start mb-2">
                            <h3 class="property-title m-0">@property.Title</h3>
                            <div class="badge-cc badge-warning">
                                <i class="bi bi-star-fill mr-1"></i> @property.Rating
                            </div>
                        </div>
                        <div class="property-location text-secondary mb-3">
                            <i class="bi bi-geo-alt-fill text-accent mr-1"></i> @property.Location
                        </div>
                        <div class="property-footer d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top: 1px solid var(--border-default);">
                            <div class="property-price">
                                <strong class="text-primary" style="font-size: 1.25rem;">GHS @property.PricePerPeriod</strong> <span class="text-muted">/ @GetRentalPeriodText(property.RentalPeriod)</span>
                            </div>
                            <div class="d-flex align-items-center flex-column">
                                <div class="form-check form-switch mr-3" style="cursor: pointer;" @onclick:stopPropagation="true">
                                    <input class="form-check-input" type="checkbox" id="bookableSwitch-@property.Id" 
                                           checked="@(property.Status == 2)" 
                                           @onchange="@(async (e) => await ToggleBookableStatus(property, (bool)e.Value!))">
                                    <label class="form-check-label" for="bookableSwitch-@property.Id">Bookable</label>
                                </div>
                                <button class="btn-cc-secondary btn-sm" @onclick:stopPropagation="true" @onclick="@(() => Navigation.NavigateTo($"/host/properties/edit/{property.Id}"))">
                                    Edit <i class="bi bi-pencil ml-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="hero-section text-center py-5 mt-4 mb-4 card-glass animated-fade-in mx-auto" style="max-width: 800px;">
            <div class="hero-icon-container mb-4">
                <i class="bi bi-house-heart display-1 text-gradient"></i>
            </div>
            <h2 class="page-title hero-title mb-4 text-gradient">Unlock the potential of your space</h2>
            <p class="hero-subtitle mb-6 text-secondary mx-auto" style="max-width: 600px;">
                Join thousands of hosts on RentIt who are turning their extra rooms and homes into sustainable income. It's safe, simple, and rewarding.
            </p>
            
            <button class="btn-cc-primary" @onclick='() => Navigation.NavigateTo("/host/properties/add")' style="padding: 14px 32px; font-size: 1.1rem;">
                Get Started Today <i class="bi bi-arrow-right ml-2"></i>
            </button>
        </div>
        
        <div class="features-grid mt-8 stagger-children">
            <div class="feature-card card-solid animate-fade-in-up text-center p-5">
                <div class="feature-icon mb-4"><i class="bi bi-wallet2 text-success display-4"></i></div>
                <h3 class="mb-3">Maximize Earnings</h3>
                <p class="text-secondary">Hosts on RentIt earn an average of GHS 2,000 per month just by sharing their spare space on weekends.</p>
            </div>
            <div class="feature-card card-solid animate-fade-in-up text-center p-5">
                <div class="feature-icon mb-4"><i class="bi bi-shield-check text-info display-4"></i></div>
                <h3 class="mb-3">Host with Confidence</h3>
                <p class="text-secondary">Every booking includes up to GHS 1M in property damage protection and verified guest screening.</p>
            </div>
            <div class="feature-card card-solid animate-fade-in-up text-center p-5">
                <div class="feature-icon mb-4"><i class="bi bi-globe-americas text-primary display-4"></i></div>
                <h3 class="mb-3">Global Reach</h3>
                <p class="text-secondary">Connect with a global community of travelers looking for unique and authentic stays.</p>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<PropertyDto>? _properties;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            _properties = await PropertyService.GetHostPropertiesAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetStatusText(int status) => status switch
    {
        1 => "Draft",
        2 => "Available",
        3 => "Rented",
        4 => "Maintenance",
        5 => "Unlisted",
        _ => "Unknown"
    };

    private string GetStatusBadgeClass(int status) => status switch
    {
        1 => "badge-secondary", // Draft
        2 => "badge-success", // Available
        3 => "badge-danger", // Rented
        4 => "badge-warning", // Maintenance
        5 => "badge-dark", // Unlisted
        _ => "badge-secondary"
    };

    private string GetRentalPeriodText(int rentalPeriod) => rentalPeriod switch
    {
        1 => "night",
        2 => "month",
        3 => "year",
        _ => "period"
    };

    private decimal CalculateMonthlyEarnings(IEnumerable<PropertyDto> properties)
    {
        return properties.Sum(p => 
        {
            if (p.RentalPeriod == 1) return p.PricePerPeriod * 15; // Assume 15 nights rented per month
            if (p.RentalPeriod == 2) return p.PricePerPeriod;      // 1 month rented per month
            if (p.RentalPeriod == 3) return p.PricePerPeriod / 12; // Yearly divided by 12
            return p.PricePerPeriod * 15;
        });
    }

    private async Task ToggleBookableStatus(PropertyDto property, bool isBookable)
    {
        try
        {
            var newStatus = isBookable ? 2 : 5; // 2 = Available, 5 = Unlisted
            var updateRequest = new UpdatePropertyRequest(
                property.Name,
                property.Description,
                property.AddressLine1,
                property.City,
                property.Region,
                property.Country,
                property.PostalCode,
                property.Type,
                property.RentalPeriod,
                property.PricePerPeriod,
                property.SecurityDeposit,
                property.Bedrooms,
                property.Bathrooms,
                property.Amenities,
                newStatus
            );

            await PropertyService.UpdatePropertyAsync(property.Id, updateRequest);
            
            // Wire to BookableProperties if it is made available
            if (isBookable)
            {
                var imageUrl = property.ImageUrls.FirstOrDefault() ?? "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80&w=800";
                
                await BookingService.CreateBookablePropertyAsync(
                    property.Id, 
                    property.Title, 
                    imageUrl,
                    property.PricePerPeriod, 
                    "GHS"
                );
            }

            _properties = await PropertyService.GetHostPropertiesAsync();
        }
        catch (Exception)
        {
            // In a real application, you might want to show a toast notification here
        }
    }
}
