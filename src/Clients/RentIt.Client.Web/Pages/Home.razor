@page "/"
@using RentIt.Shared.DTOs.Properties
@using RentIt.Client.Web.Services
@inject IPropertyService PropertyService
@inject NavigationManager Navigation

<div class="page-container">
    <section class="hero-section" style="background: linear-gradient(rgba(11, 11, 16, 0.7), rgba(11, 11, 16, 0.7)), url('https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&q=80&w=2000') center/cover;">
        <div class="hero-content">
            <h1 class="hero-title">Find Your Perfect Stay</h1>
            <p class="hero-subtitle">Discover luxury villas, cozy cabins, and city lofts.</p>
            
            <div class="search-bar-container">
                <div class="search-input-wrapper">
                    <i class="bi bi-geo-alt-fill search-icon"></i>
                    <input type="text" placeholder="Where are you going?" class="search-input" />
                </div>
                <button class="btn btn-primary search-btn">Search</button>
            </div>
        </div>
    </section>

    <section class="properties-section">
        <h2 class="section-title">Featured Properties</h2>

        @if (_properties == null)
        {
            <div class="properties-grid">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="property-card skeleton-card">
                        <div class="skeleton-img"></div>
                        <div class="skeleton-content">
                            <div class="skeleton-title"></div>
                            <div class="skeleton-location"></div>
                            <div class="skeleton-price"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="properties-grid">
                @foreach (var property in _properties)
                {
                    <div class="property-card" @onclick="() => NavigateToProperty(property.Id)">
                        <div class="property-img-wrapper" style="position: relative;">
                            <div class="property-banner property-type-@property.Type">
                                @GetPropertyTypeName(property.Type)
                            </div>
                            <img src="@GetImageUrl(property)" alt="@property.Name" class="property-img" />
                        </div>
                        <div class="property-content">
                            <div class="property-header">
                                <h3 class="property-title">@property.Name</h3>
                                <div class="property-rating">
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <span>5.0</span>
                                </div>
                            </div>
                            <div class="property-location">
                                <i class="bi bi-geo-alt"></i> @property.City, @property.Country
                            </div>
                            <div class="property-price">
                                <strong>GHS @property.PricePerPeriod</strong> <span class="text-muted">@GetPriceSuffix(property.RentalPeriod)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>



@code {
    private IEnumerable<PropertyDto>? _properties;

    protected override async Task OnInitializedAsync()
    {
        var allProperties = await PropertyService.GetAllPropertiesAsync();
        if (allProperties != null)
        {
            _properties = allProperties.Where(p => p.Status == 1).ToList();
        }
    }

    private string GetImageUrl(PropertyDto property)
    {
        var url = property.Images?.FirstOrDefault();
        return string.IsNullOrWhiteSpace(url) 
            ? "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80&w=800" 
            : url;
    }

    private string GetPropertyTypeName(int typeId) => typeId switch
    {
        1 => "Apartment",
        2 => "House",
        3 => "Villa",
        4 => "Guesthouse",
        5 => "Commercial",
        6 => "Single Room",
        7 => "Compound House",
        _ => "Property"
    };

    private string GetPriceSuffix(int period) => period switch
    {
        1 => "/ night",
        2 => "/ month",
        3 => "/ year",
        _ => ""
    };

    private void NavigateToProperty(Guid id)
    {
        Navigation.NavigateTo($"/properties/{id}");
    }
}
