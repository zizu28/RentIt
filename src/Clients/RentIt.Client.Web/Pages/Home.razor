@page "/"
@using RentIt.Shared.DTOs.Properties
@using RentIt.Client.Web.Services
@inject IPropertyService PropertyService
@inject NavigationManager Navigation

<div class="page-container">
    <section class="hero-section" style="background: linear-gradient(rgba(11, 11, 16, 0.7), rgba(11, 11, 16, 0.7)), url('https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&q=80&w=2000') center/cover;">
        <div class="hero-content">
            <h1 class="hero-title">Find Your Perfect Stay</h1>
            <p class="hero-subtitle">Discover luxury villas, cozy cabins, and city lofts.</p>
            
            <div class="search-bar-container">
                <div class="search-input-wrapper">
                    <i class="bi bi-geo-alt-fill search-icon"></i>
                    <input type="text" placeholder="Where are you going?" class="search-input" />
                </div>
                <button class="btn btn-primary search-btn">Search</button>
            </div>
        </div>
    </section>

    <section class="properties-section">
        <h2 class="section-title">Featured Properties</h2>

        @if (_properties == null)
        {
            <div class="properties-grid">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="property-card skeleton-card">
                        <div class="skeleton-img"></div>
                        <div class="skeleton-content">
                            <div class="skeleton-title"></div>
                            <div class="skeleton-location"></div>
                            <div class="skeleton-price"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="properties-grid">
                @foreach (var property in _properties)
                {
                    <div class="property-card" @onclick="() => NavigateToProperty(property.Id)">
                        <div class="property-img-wrapper">
                            <img src="@GetImageUrl(property)" alt="@property.Title" class="property-img" />
                        </div>
                        <div class="property-content">
                            <div class="property-header">
                                <h3 class="property-title">@property.Title</h3>
                                <div class="property-rating">
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <span>@property.Rating</span>
                                </div>
                            </div>
                            <div class="property-location">
                                <i class="bi bi-geo-alt"></i> @property.Location
                            </div>
                            <div class="property-price">
                                <strong>$@property.PricePerNight</strong> <span class="text-muted">/ night</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

<style>
    .page-container {
        padding: 0 0 4rem 0;
    }
    .hero-section {
        height: 60vh;
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        border-radius: 24px;
        margin: 24px;
        overflow: hidden;
        position: relative;
        box-shadow: var(--shadow-lg);
    }
    .hero-content {
        position: relative;
        z-index: 2;
        padding: 2rem;
        max-width: 800px;
    }
    .hero-title {
        font-size: 3.5rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
    }
    .hero-subtitle {
        font-size: 1.25rem;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 2.5rem;
    }
    .search-bar-container {
        display: flex;
        background: var(--bg-glass);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding: 8px;
        border-radius: 100px;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-subtle);
        max-width: 600px;
        margin: 0 auto;
    }
    .search-input-wrapper {
        flex: 1;
        display: flex;
        align-items: center;
        padding: 0 1rem;
    }
    .search-icon {
        color: var(--text-muted);
        margin-right: 12px;
        font-size: 1.2rem;
    }
    .search-input {
        width: 100%;
        background: transparent;
        border: none;
        color: var(--text-primary);
        font-size: 1.1rem;
        outline: none;
    }
    .search-input::placeholder {
        color: var(--text-muted);
    }
    .search-btn {
        border-radius: 100px;
        padding: 12px 32px;
        font-size: 1.1rem;
        font-weight: 600;
    }
    .properties-section {
        padding: 2rem 24px;
        max-width: 1400px;
        margin: 0 auto;
    }
    .section-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        color: var(--text-primary);
    }
    .properties-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
    }
    .property-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border-default);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        cursor: pointer;
        display: flex;
        flex-direction: column;
    }
    .property-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
        border-color: var(--border-strong);
    }
    .property-img-wrapper {
        height: 220px;
        width: 100%;
        overflow: hidden;
    }
    .property-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .property-card:hover .property-img {
        transform: scale(1.05);
    }
    .property-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .property-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.5rem;
    }
    .property-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }
    .property-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        font-weight: 600;
        font-size: 0.9rem;
    }
    .property-location {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .property-price {
        margin-top: auto;
        font-size: 1.2rem;
        color: var(--text-primary);
    }
    .text-muted {
        color: var(--text-muted);
        font-size: 0.9rem;
    }
    .text-warning {
        color: var(--color-warning);
    }

    /* Skeleton Loading */
    .skeleton-card {
        pointer-events: none;
    }
    .skeleton-img {
        height: 220px;
        background: var(--bg-tertiary);
        animation: pulse 1.5s infinite ease-in-out;
    }
    .skeleton-content {
        padding: 1.5rem;
    }
    .skeleton-title {
        height: 24px;
        width: 80%;
        background: var(--bg-tertiary);
        border-radius: 4px;
        margin-bottom: 0.5rem;
        animation: pulse 1.5s infinite ease-in-out;
    }
    .skeleton-location {
        height: 16px;
        width: 50%;
        background: var(--bg-tertiary);
        border-radius: 4px;
        margin-bottom: 1rem;
        animation: pulse 1.5s infinite ease-in-out;
    }
    .skeleton-price {
        height: 24px;
        width: 40%;
        background: var(--bg-tertiary);
        border-radius: 4px;
        animation: pulse 1.5s infinite ease-in-out;
    }
    @@keyframes pulse {
        0% { opacity: 0.6; }
        50% { opacity: 1; }
        100% { opacity: 0.6; }
    }
</style>

@code {
    private IEnumerable<PropertyDto>? _properties;

    protected override async Task OnInitializedAsync()
    {
        _properties = await PropertyService.GetAllPropertiesAsync();
    }

    private string GetImageUrl(PropertyDto property) => property.ImageUrls.FirstOrDefault() ?? string.Empty;

    private void NavigateToProperty(Guid id)
    {
        Navigation.NavigateTo($"/properties/{id}");
    }
}
