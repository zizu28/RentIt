@page "/guest/pending-payments"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using global::RentIt.Client.Web.Services
@using global::RentIt.Shared.DTOs.Bookings
@inject IBookingService BookingService
@inject IPaymentService PaymentService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="page-container animate-fade-in-up">
    <div class="breadcrumbs mb-4">
        <a href="/">Home</a> <span>/</span> <span class="active">Pending Payments</span>
    </div>
    
    <div class="section-header-cc mb-6">
        <div>
            <h1 class="page-title mb-2">Pending Payments</h1>
            <p class="hero-subtitle m-0">Complete your payments to secure your bookings.</p>
        </div>
    </div>

    @if (_bookings == null)
    {
        <div class="loading-spinner-container mt-5 text-center">
            <div class="loading-progress">
                <svg><circle cx="64" cy="64" r="56"></circle><circle cx="64" cy="64" r="56"></circle></svg>
            </div>
            <p class="mt-3 text-secondary">Loading pending payments...</p>
        </div>
    }
    else if (!_bookings.Any())
    {
        <div class="hero-section text-center py-5 mt-4 mb-4 card-glass animated-fade-in mx-auto" style="max-width: 800px;">
            <div class="hero-icon-container mb-4">
                <i class="bi bi-check-circle display-1 text-success"></i>
            </div>
            <h2 class="page-title hero-title mb-4">You're all caught up!</h2>
            <p class="hero-subtitle mb-6 text-secondary mx-auto" style="max-width: 600px;">
                You have no pending payments at this time.
            </p>
            <a href="/" class="btn-cc-primary">Explore properties</a>
        </div>
    }
    else
    {
        <div class="bookings-grid">
            @foreach (var booking in _bookings.OrderBy(b => b.StartDate))
            {
                <div class="card-glass booking-card animate-fade-in-up">
                    <div class="booking-img-wrapper">
                        <img src="@booking.PropertyImageUrl" alt="@booking.PropertyTitle" class="booking-img" />
                        <span class="badge-cc badge-warning booking-status">
                            <i class="bi bi-hourglass-split"></i> @booking.Status
                        </span>
                    </div>
                    <div class="p-4">
                        <h3 class="font-weight-bold mb-3">@booking.PropertyTitle</h3>
                        
                        <div class="d-flex align-items-center mb-2 text-secondary">
                            <i class="bi bi-calendar3 mr-2 text-primary"></i>
                            <span>@booking.StartDate.ToString("MMM dd, yyyy") - @booking.EndDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        
                        <div class="d-flex align-items-center mb-4 text-secondary">
                            <i class="bi bi-credit-card mr-2 text-primary"></i>
                            <span class="font-weight-bold">@booking.Currency @booking.TotalPrice.ToString("N2") total</span>
                        </div>
                        
                        <hr class="mb-4 opacity-50" />
                        
                        <div class="d-flex flex-column" style="gap: 1rem;">
                            <button class="btn-cc-primary w-100" @onclick="() => PayNowAsync(booking)" disabled="@_isProcessing">
                                @if (_isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                                    <span>Processing...</span>
                                }
                                else
                                {
                                    <i class="bi bi-wallet2 mr-2"></i> <span>Pay Now</span>
                                }
                            </button>
                            <button class="btn-cc-secondary w-100" @onclick="() => NavigateToProperty(booking.PropertyId)">
                                <i class="bi bi-building mr-2"></i> View Property
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<BookingDto>? _bookings;
    private bool _isProcessing = false;
    private string _userEmail = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _userEmail = user.FindFirst(c => c.Type == ClaimTypes.Email)?.Value ?? "";

        var allBookings = await BookingService.GetMyBookingsAsync();
        _bookings = allBookings.Where(b => b.Status == "Pending");
    }

    private void NavigateToProperty(Guid id)
    {
        Navigation.NavigateTo($"/properties/{id}");
    }

    private async Task PayNowAsync(BookingDto booking)
    {
        _isProcessing = true;
        try
        {
            var paymentRequest = new InitializePaymentRequestDto
            {
                BookingId = booking.Id,
                Email = _userEmail,
                Amount = booking.TotalPrice,
                Currency = booking.Currency,
                CallbackUrl = Navigation.BaseUri + "bookings"
            };

            var paymentResult = await PaymentService.InitializePaymentAsync(paymentRequest);

            if (paymentResult.Status)
            {
                Navigation.NavigateTo(paymentResult.AuthorizationUrl);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Could not initialize payment. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Payment initialization failed: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
