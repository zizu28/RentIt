@page "/properties/{Id:guid}"
@using RentIt.Shared.DTOs.Properties
@using RentIt.Shared.DTOs.Bookings
@using RentIt.Client.Web.Services
@inject IPropertyService PropertyService
@inject IBookingService BookingService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@* Removing Snackbar dependency as we don't have MudBlazor anymore, we will use a simple status message *@

<div class="page-container">
    <div class="breadcrumbs">
        <a href="/">Home</a> <span>/</span>
        <a href="/host/dashboard">Host Dashboard</a> <span>/</span>
        <span class="active">@(_property?.Name ?? "Property Details")</span>
    </div>

    @if (_property == null)
    {
        <div class="loading-spinner-container">
            <span class="spinner large"></span>
        </div>
    }
    else
    {
        <h1 class="page-title mb-2">@_property.Name</h1>
        
        <div class="alert @GetStatusCssClass(_property.Status) mb-4 d-inline-block px-3 py-1 rounded-pill" style="font-size: 0.85rem; font-weight: 600;">
            @GetStatusText(_property.Status)
        </div>

        <div class="property-meta mb-6">
            <i class="bi bi-star-fill text-warning"></i>
            <span class="font-weight-600">5.0</span>
            <span class="text-secondary mx-2">·</span>
            <i class="bi bi-geo-alt"></i>
            <span class="text-underline">@_property.City, @_property.Country</span>
        </div>

        <div class="property-gallery mb-8 relative">
            @if (_property.Images != null && _property.Images.Any())
            {
                <img src="@_property.Images[_currentImageIndex]" alt="Property Image" class="gallery-main-img" />
                
                @if (_property.Images.Count > 1)
                {
                    <button class="carousel-btn prev-btn" @onclick="PrevImage">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button class="carousel-btn next-btn" @onclick="NextImage">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <div class="carousel-indicators">
                        @for (int i = 0; i < _property.Images.Count; i++)
                        {
                            var index = i;
                            <span class="indicator @(index == _currentImageIndex ? "active" : "")" @onclick="() => _currentImageIndex = index"></span>
                        }
                    </div>
                }
            }
            else
            {
                <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80&w=800" alt="Placeholder Image" class="gallery-main-img" />
            }
        </div>

        <div class="property-layout">
            <div class="property-info">
                <h2 class="section-subtitle">Entire home hosted by RentIt</h2>
                <p class="text-secondary mb-6">@_property.MaxGuests guests · Entire place</p>
                
                <hr class="divider mb-6" />
                
                <p class="property-description mb-6">@_property.Description</p>

                <hr class="divider mb-6" />

                <h2 class="section-subtitle mb-4">What this place offers</h2>
                @if (_property.Amenities != null && _property.Amenities.Any())
                {
                    <div class="amenities-grid">
                        @foreach (var amenity in _property.Amenities)
                        {
                            <div class="amenity-item">
                                <i class="bi bi-check-circle amenity-icon"></i>
                                <span>@amenity</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-secondary">No amenities listed.</p>
                }
            </div>

            <div class="property-booking">
                <div class="booking-widget">
                    <div class="booking-price mb-2">
                        <span class="price-amount">GHS @_property.PricePerPeriod</span>
                        <span class="price-label">@GetPriceSuffix(_property.RentalPeriod)</span>
                    </div>

                    @if (_property.SecurityDeposit > 0)
                    {
                        <div class="security-deposit mb-6" style="color: var(--text-secondary); font-size: 0.9rem;">
                            Security Deposit: GHS @_property.SecurityDeposit
                        </div>
                    }
                    else
                    {
                        <div class="mb-6"></div>
                    }

                    <div class="form-group">
                        <label>Check-in</label>
                        <input type="date" class="form-control mb-3" @bind="CheckInDate" min="@_minCheckInDate" />
                        
                        <label>Check-out</label>
                        <input type="date" class="form-control mb-4" @bind="CheckOutDate" min="@(CheckInDate?.AddDays(1).ToString("yyyy-MM-dd") ?? _minCheckInDate)" max="@_maxCheckOutDate" />
                    </div>
                    
                    <div class="form-group mb-6">
                        <label>Guests</label>
                        <select class="form-control" @bind="_guests">
                            @for (int i = 1; i <= _property.MaxGuests; i++)
                            {
                                <option value="@i">@i guest@(i > 1 ? "s" : "")</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(_statusMessage))
                    {
                        <div class="alert @(_isError ? "alert-danger" : "alert-success") mb-4">
                            @_statusMessage
                        </div>
                    }

                    <AuthorizeView>
                        <Authorized>
                            @if (_isHost)
                            {
                                <div class="alert alert-info mb-4">
                                    <i class="bi bi-info-circle mr-2"></i> You cannot reserve your own property.
                                </div>
                                <button class="btn btn-secondary full-width rounded-lg py-3 mb-4" disabled>
                                    Reserve
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-primary full-width rounded-lg py-3 mb-4" @onclick="ReserveAsync" disabled="@_isBooking">
                                    @if (_isBooking)
                                    {
                                        <span class="spinner"></span>
                                        <span>Processing...</span>
                                    }
                                    else
                                    {
                                        <span>Reserve</span>
                                    }
                                </button>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login?returnUrl=/properties/@Id" class="btn btn-primary full-width rounded-lg py-3 mb-4 text-center d-inline-block" style="text-decoration: none;">
                                Login to Reserve
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>

                    @if (CheckInDate.HasValue && CheckOutDate.HasValue && (CheckOutDate.Value - CheckInDate.Value).Days > 0)
                    {
                        var nights = (CheckOutDate.Value - CheckInDate.Value).Days;
                        <div class="price-breakdown">
                            @if (_property.RentalPeriod == 1)
                            {
                                <div class="price-row mb-2">
                                    <span>GHS @_property.PricePerPeriod x @nights nights</span>
                                    <span>GHS @(_property.PricePerPeriod * nights)</span>
                                </div>
                                <hr class="divider my-4" />
                                <div class="price-row total-row">
                                    <span>Total</span>
                                    <span>GHS @((_property.PricePerPeriod * nights) + _property.SecurityDeposit)</span>
                                </div>
                            }
                            else
                            {
                                <div class="price-row mb-2">
                                    <span>Rental Duration</span>
                                    <span>@nights days</span>
                                </div>
                                <hr class="divider my-4" />
                                <div class="price-row total-row">
                                    <span>Subtotal</span>
                                    <span>To be calculated</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>



@code {
    [Parameter] public Guid Id { get; set; }
    private PropertyDto? _property;
    
    private DateTime? _checkInDate;
    private DateTime? CheckInDate
    {
        get => _checkInDate;
        set
        {
            _checkInDate = value;
            ValidateDates();
        }
    }

    private DateTime? _checkOutDate;
    private DateTime? CheckOutDate
    {
        get => _checkOutDate;
        set
        {
            _checkOutDate = value;
            ValidateDates();
        }
    }

    private int _guests = 1;
    private bool _isBooking;
    private bool _isHost = false;
    private int _currentImageIndex = 0;
    
    private string _statusMessage = string.Empty;
    private bool _isError = false;

    private List<BookedPeriodDto> _bookedPeriods = new();
    private string _minCheckInDate = DateTime.Today.ToString("yyyy-MM-dd");
    private string? _maxCheckOutDate;

    protected override async Task OnInitializedAsync()
    {
        _property = await PropertyService.GetPropertyByIdAsync(Id);
        _bookedPeriods = (await BookingService.GetPropertyBookedPeriodsAsync(Id)).ToList();
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdString = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        
        if (Guid.TryParse(userIdString, out var currentUserId) && _property != null)
        {
            _isHost = currentUserId == _property.HostId;
        }
    }

    private void NextImage()
    {
        if (_property?.Images != null && _property.Images.Count > 0)
        {
            _currentImageIndex = (_currentImageIndex + 1) % _property.Images.Count;
        }
    }

    private void PrevImage()
    {
        if (_property?.Images != null && _property.Images.Count > 0)
        {
            _currentImageIndex = (_currentImageIndex - 1 + _property.Images.Count) % _property.Images.Count;
        }
    }

    private string GetPriceSuffix(int period) => period switch
    {
        1 => "/ night",
        2 => "/ month",
        3 => "/ year",
        _ => ""
    };

    private string GetStatusText(int status) => status switch
    {
        1 => "Draft",
        2 => "Available",
        3 => "Rented",
        4 => "Maintenance",
        5 => "Unlisted",
        _ => "Unknown"
    };

    private string GetStatusCssClass(int status) => status switch
    {
        1 => "alert-secondary",
        2 => "alert-success",
        3 => "alert-danger",
        4 => "alert-warning",
        5 => "alert-dark",
        _ => "alert-secondary"
    };

    private void ValidateDates()
    {
        _statusMessage = string.Empty;
        _isError = false;
        _maxCheckOutDate = null; // Reset max checkout date

        if (_checkInDate.HasValue)
        {
            // Ensure CheckInDate is not inside a booked period
            var checkInDateOnly = DateOnly.FromDateTime(_checkInDate.Value);
            var isConflict = _bookedPeriods.Any(b => checkInDateOnly >= b.StartDate && checkInDateOnly < b.EndDate);
            
            if (isConflict)
            {
                _statusMessage = "The selected check-in date is already booked.";
                _isError = true;
                _checkInDate = null; // Clear it
                return;
            }

            // Find the next booked period after CheckInDate to restrict CheckOutDate max
            var nextBooking = _bookedPeriods
                .Where(b => b.StartDate > checkInDateOnly)
                .OrderBy(b => b.StartDate)
                .FirstOrDefault();

            if (nextBooking != null)
            {
                _maxCheckOutDate = nextBooking.StartDate.ToString("yyyy-MM-dd");
            }
        }

        if (_checkInDate.HasValue && _checkOutDate.HasValue)
        {
            var checkInDateOnly = DateOnly.FromDateTime(_checkInDate.Value);
            var checkOutDateOnly = DateOnly.FromDateTime(_checkOutDate.Value);

            if (checkOutDateOnly <= checkInDateOnly)
            {
                _statusMessage = "Check-out date must be after check-in date.";
                _isError = true;
                _checkOutDate = null;
                return;
            }

            var overlap = _bookedPeriods.Any(b => 
                (checkInDateOnly < b.EndDate && checkOutDateOnly > b.StartDate));
                
            if (overlap)
            {
                _statusMessage = "The selected dates overlap with an existing reservation.";
                _isError = true;
                _checkOutDate = null;
            }
        }
    }

    private async Task ReserveAsync()
    {
        _statusMessage = string.Empty;

        if (CheckInDate == null || CheckOutDate == null)
        {
            _statusMessage = "Please select valid check-in and check-out dates.";
            _isError = true;
            return;
        }

        Navigation.NavigateTo($"/checkout/{Id}?checkIn={CheckInDate.Value:yyyy-MM-dd}&checkOut={CheckOutDate.Value:yyyy-MM-dd}");
    }
}
