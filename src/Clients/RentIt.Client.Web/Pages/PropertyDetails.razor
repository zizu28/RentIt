@page "/properties/{Id:guid}"
@using RentIt.Shared.DTOs.Properties
@using RentIt.Client.Web.Services
@inject IPropertyService PropertyService
@inject IBookingService BookingService
@inject NavigationManager Navigation
@* Removing Snackbar dependency as we don't have MudBlazor anymore, we will use a simple status message *@

<div class="page-container">
    <div class="breadcrumbs">
        <a href="/">Home</a> <span>/</span> 
        <span class="active">@(_property?.Title ?? "Property Details")</span>
    </div>

    @if (_property == null)
    {
        <div class="loading-spinner-container">
            <span class="spinner large"></span>
        </div>
    }
    else
    {
        <h1 class="page-title mb-2">@_property.Title</h1>
        <div class="property-meta mb-6">
            <i class="bi bi-star-fill text-warning"></i>
            <span class="font-weight-600">@_property.Rating</span>
            <span class="text-secondary mx-2">·</span>
            <i class="bi bi-geo-alt"></i>
            <span class="text-underline">@_property.Location</span>
        </div>

        <div class="property-gallery mb-8">
            <img src="@GetImageUrl()" alt="Property Image" class="gallery-main-img" />
        </div>

        <div class="property-layout">
            <div class="property-info">
                <h2 class="section-subtitle">Entire home hosted by RentIt</h2>
                <p class="text-secondary mb-6">@_property.MaxGuests guests · Entire place</p>
                
                <hr class="divider mb-6" />
                
                <p class="property-description mb-6">@_property.Description</p>

                <hr class="divider mb-6" />

                <h2 class="section-subtitle mb-4">What this place offers</h2>
                <div class="amenities-grid">
                    @foreach (var amenity in _property.Amenities)
                    {
                        <div class="amenity-item">
                            <i class="bi bi-check-circle amenity-icon"></i>
                            <span>@amenity</span>
                        </div>
                    }
                </div>
            </div>

            <div class="property-booking">
                <div class="booking-widget">
                    <div class="booking-price mb-6">
                        <span class="price-amount">$@_property.PricePerNight</span>
                        <span class="price-label">night</span>
                    </div>

                    <div class="form-group">
                        <label>Check-in</label>
                        <input type="date" class="form-control mb-3" @bind="CheckInDate" />
                        
                        <label>Check-out</label>
                        <input type="date" class="form-control mb-4" @bind="CheckOutDate" />
                    </div>
                    
                    <div class="form-group mb-6">
                        <label>Guests</label>
                        <select class="form-control" @bind="_guests">
                            @for (int i = 1; i <= _property.MaxGuests; i++)
                            {
                                <option value="@i">@i guest@(i > 1 ? "s" : "")</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(_statusMessage))
                    {
                        <div class="alert @(_isError ? "alert-danger" : "alert-success") mb-4">
                            @_statusMessage
                        </div>
                    }

                    <AuthorizeView>
                        <Authorized>
                            <button class="btn btn-primary full-width rounded-lg py-3 mb-4" @onclick="ReserveAsync" disabled="@_isBooking">
                                @if (_isBooking)
                                {
                                    <span class="spinner"></span>
                                    <span>Processing...</span>
                                }
                                else
                                {
                                    <span>Reserve</span>
                                }
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login?returnUrl=/properties/@Id" class="btn btn-primary full-width rounded-lg py-3 mb-4 text-center d-inline-block" style="text-decoration: none;">
                                Login to Reserve
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>

                    @if (CheckInDate.HasValue && CheckOutDate.HasValue && (CheckOutDate.Value - CheckInDate.Value).Days > 0)
                    {
                        var nights = (CheckOutDate.Value - CheckInDate.Value).Days;
                        <div class="price-breakdown">
                            <div class="price-row mb-2">
                                <span>$@_property.PricePerNight x @nights nights</span>
                                <span>$@(_property.PricePerNight * nights)</span>
                            </div>
                            <hr class="divider my-4" />
                            <div class="price-row total-row">
                                <span>Total</span>
                                <span>$@(_property.PricePerNight * nights)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>



@code {
    [Parameter] public Guid Id { get; set; }
    private PropertyDto? _property;
    private DateTime? CheckInDate;
    private DateTime? CheckOutDate;
    private int _guests = 1;
    private bool _isBooking;
    
    private string _statusMessage = string.Empty;
    private bool _isError = false;

    protected override async Task OnInitializedAsync()
    {
        _property = await PropertyService.GetPropertyByIdAsync(Id);
    }

    private string GetImageUrl() => _property?.ImageUrls.FirstOrDefault() ?? string.Empty;

    private async Task ReserveAsync()
    {
        _statusMessage = string.Empty;

        if (CheckInDate == null || CheckOutDate == null)
        {
            _statusMessage = "Please select check-in and check-out dates.";
            _isError = true;
            return;
        }

        if ((CheckOutDate.Value - CheckInDate.Value).Days <= 0)
        {
            _statusMessage = "Check-out date must be after check-in date.";
            _isError = true;
            return;
        }

        Navigation.NavigateTo($"/checkout/{Id}?checkIn={CheckInDate.Value:yyyy-MM-dd}&checkOut={CheckOutDate.Value:yyyy-MM-dd}");
    }
}
