@page "/bookings"
@using RentIt.Shared.DTOs.Bookings
@using RentIt.Client.Web.Services
@inject IBookingService BookingService
@inject IPaymentService PaymentService
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="page-container">
    <div class="breadcrumbs">
        <a href="/">Home</a> <span>/</span> <span class="active">My Bookings</span>
    </div>
    
    <h1 class="page-title">My Bookings</h1>

    @if (!string.IsNullOrEmpty(_toastMessage))
    {
        <div class="toast-notification @_toastType">
            @if (_toastType == "loading")
            {
                <span class="spinner"></span>
            }
            else if (_toastType == "success")
            {
                <i class="bi bi-check-circle-fill text-success"></i>
            }
            else
            {
                <i class="bi bi-exclamation-circle-fill text-danger"></i>
            }
            <span>@_toastMessage</span>
        </div>
    }

    @if (_bookings == null)
    {
        <div class="loading-spinner-container">
            <span class="spinner large"></span>
        </div>
    }
    else if (!_bookings.Any())
    {
        <div class="empty-state">
            <i class="bi bi-airplane empty-state-icon"></i>
            <h2>No trips booked... yet!</h2>
            <p>Time to dust off your bags and start planning your next adventure.</p>
            <a href="/" class="btn btn-primary mt-4">Start searching</a>
        </div>
    }
    else
    {
        <div class="bookings-grid">
            @foreach (var booking in _bookings.OrderBy(b => b.StartDate))
            {
                <div class="booking-card">
                    <div class="booking-img-wrapper">
                        <img src="@booking.PropertyImageUrl" alt="@booking.PropertyTitle" class="booking-img" />
                        <span class="booking-status @GetStatusBadgeClass(booking.Status)">@booking.Status</span>
                    </div>
                    <div class="booking-content">
                        <h3 class="booking-title">@booking.PropertyTitle</h3>
                        <hr class="divider" />
                        
                        <div class="booking-detail">
                            <i class="bi bi-calendar3"></i>
                            <span>@booking.StartDate.ToString("MMM dd, yyyy") - @booking.EndDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        
                        <div class="booking-detail">
                            <i class="bi bi-credit-card"></i>
                            <span>$@booking.TotalPrice total</span>
                        </div>
                    </div>
                    <div class="booking-actions">
                        <button class="btn btn-outline full-width" @onclick="() => NavigateToProperty(booking.PropertyId)">View Property</button>
                    </div>
                </div>
            }
        </div>
    }
</div>



@code {
    [SupplyParameterFromQuery]
    [Parameter]
    public string? Reference { get; set; }

    private IEnumerable<BookingDto>? _bookings;
    private string _toastMessage = string.Empty;
    private string _toastType = "loading";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Reference))
        {
            _toastMessage = "Verifying payment...";
            _toastType = "loading";
            StateHasChanged();

            var success = await PaymentService.VerifyPaymentAsync(Reference);
            if (success)
            {
                _toastMessage = "Payment successful!";
                _toastType = "success";
            }
            else
            {
                _toastMessage = "Payment verification failed or still pending.";
                _toastType = "error";
            }
            
            // Remove reference from URL so it doesn't verify again on refresh
            Navigation.NavigateTo("/bookings", replace: true);
            
            // Hide toast after 5 seconds
            _ = Task.Run(async () =>
            {
                await Task.Delay(5000);
                _toastMessage = string.Empty;
                await InvokeAsync(StateHasChanged);
            });
        }

        _bookings = await BookingService.GetMyBookingsAsync();
    }

    private void NavigateToProperty(Guid id)
    {
        Navigation.NavigateTo($"/properties/{id}");
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "badge-warning",
        "Confirmed" => "badge-success",
        "Cancelled" => "badge-secondary",
        "Completed" => "badge-primary",
        "Refunded" => "badge-info",
        "PartiallyPaid" => "badge-warning",
        "Failed" => "badge-danger",
        _ => "badge-secondary"
    };
}
