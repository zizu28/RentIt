@page "/bookings"
@using RentIt.Shared.DTOs.Bookings
@using RentIt.Client.Web.Services
@inject IBookingService BookingService
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="page-container">
    <div class="breadcrumbs">
        <a href="/">Home</a> <span>/</span> <span class="active">My Bookings</span>
    </div>
    
    <h1 class="page-title">My Bookings</h1>

    @if (_bookings == null)
    {
        <div class="loading-spinner-container">
            <span class="spinner large"></span>
        </div>
    }
    else if (!_bookings.Any())
    {
        <div class="empty-state">
            <i class="bi bi-airplane empty-state-icon"></i>
            <h2>No trips booked... yet!</h2>
            <p>Time to dust off your bags and start planning your next adventure.</p>
            <a href="/" class="btn btn-primary mt-4">Start searching</a>
        </div>
    }
    else
    {
        <div class="bookings-grid">
            @foreach (var booking in _bookings.OrderBy(b => b.StartDate))
            {
                <div class="booking-card">
                    <div class="booking-img-wrapper">
                        <img src="@booking.PropertyImageUrl" alt="@booking.PropertyTitle" class="booking-img" />
                        <span class="booking-status badge-success">@booking.Status</span>
                    </div>
                    <div class="booking-content">
                        <h3 class="booking-title">@booking.PropertyTitle</h3>
                        <hr class="divider" />
                        
                        <div class="booking-detail">
                            <i class="bi bi-calendar3"></i>
                            <span>@booking.StartDate.ToString("MMM dd, yyyy") - @booking.EndDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        
                        <div class="booking-detail">
                            <i class="bi bi-credit-card"></i>
                            <span>$@booking.TotalPrice total</span>
                        </div>
                    </div>
                    <div class="booking-actions">
                        <button class="btn btn-outline full-width" @onclick="() => NavigateToProperty(booking.PropertyId)">View Property</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .page-container {
        padding: 2rem 24px;
        max-width: 1200px;
        margin: 0 auto;
    }
    .breadcrumbs {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 2rem;
    }
    .breadcrumbs a {
        color: var(--text-link);
        text-decoration: none;
    }
    .breadcrumbs .active {
        color: var(--text-primary);
    }
    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 2rem;
    }
    .empty-state {
        background: var(--bg-elevated);
        border: 1px solid var(--border-default);
        border-radius: 24px;
        padding: 4rem 2rem;
        text-align: center;
        box-shadow: var(--shadow-sm);
    }
    .empty-state-icon {
        font-size: 4rem;
        color: var(--accent-primary);
        margin-bottom: 1.5rem;
        display: block;
    }
    .empty-state h2 {
        font-size: 1.8rem;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }
    .empty-state p {
        color: var(--text-secondary);
        font-size: 1.1rem;
    }
    .bookings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
    }
    .booking-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border-default);
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-sm);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .booking-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-md);
    }
    .booking-img-wrapper {
        position: relative;
        height: 200px;
    }
    .booking-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .booking-status {
        position: absolute;
        top: 12px;
        right: 12px;
        background: var(--color-success);
        color: white;
        padding: 4px 12px;
        border-radius: 100px;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
    .booking-content {
        padding: 1.5rem;
        flex: 1;
    }
    .booking-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 1rem 0;
        line-height: 1.3;
    }
    .divider {
        border: 0;
        height: 1px;
        background: var(--border-default);
        margin: 1rem 0;
    }
    .booking-detail {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--text-secondary);
        margin-bottom: 0.75rem;
        font-size: 0.95rem;
    }
    .booking-detail i {
        color: var(--text-muted);
    }
    .booking-actions {
        padding: 1rem 1.5rem;
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-default);
    }
    .full-width {
        width: 100%;
    }
    .loading-spinner-container {
        display: flex;
        justify-content: center;
        padding: 4rem;
    }
</style>

@code {
    private IEnumerable<BookingDto>? _bookings;

    protected override async Task OnInitializedAsync()
    {
        _bookings = await BookingService.GetMyBookingsAsync();
    }

    private void NavigateToProperty(Guid id)
    {
        Navigation.NavigateTo($"/properties/{id}");
    }
}
