@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using RentIt.Client.Web.Auth
@inherits LayoutComponentBase

<div class="layout-container">
    <header class="top-nav-header">
        <div class="nav-content">
            <div class="nav-left">
                <a href="/" class="logo">
                    <i class="bi bi-house-door-fill" style="font-size: 1.5rem; color: var(--accent-primary); margin-right: 8px;"></i>
                    <span class="logo-text">RentIt</span>
                </a>

                <!-- Desktop Nav -->
                <nav class="main-navigation">
                    <NavLink href="/" Match="NavLinkMatch.All" class="nav-link">Home</NavLink>
                    <AuthorizeView>
                        <Authorized>
                            <NavLink href="/bookings" Match="NavLinkMatch.Prefix" class="nav-link">My Bookings</NavLink>
                            <NavLink href="/profile" Match="NavLinkMatch.Prefix" class="nav-link">Profile</NavLink>
                        </Authorized>
                    </AuthorizeView>
                </nav>
            </div>

            <div class="nav-right">
                <button class="icon-btn theme-toggle" @onclick="ToggleTheme" title="Toggle Theme" style="margin-right: 12px;">
                    <i class="bi @(_isDarkMode ? "bi-moon-fill" : "bi-sun-fill")"></i>
                </button>

                <AuthorizeView>
                    <Authorized>
                        @{
                            var profileImageUrl = context.User.FindFirst("ProfileImageUrl")?.Value;
                            var name = context.User.Identity?.Name ?? context.User.FindFirst(ClaimTypes.Email)?.Value;
                        }
                        
                        <div class="user-greeting-container">
                            @if (!string.IsNullOrEmpty(profileImageUrl))
                            {
                                <img src="@profileImageUrl" alt="User Profile" class="user-profile-img" />
                            }
                            <span class="user-greeting">Welcome, <strong>@name</strong></span>
                        </div>

                        <button class="btn btn-logout" @onclick="Logout" title="Log out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-outline" style="margin-right: 12px;">Login</a>
                        <a href="/register" class="btn btn-primary">Register</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>
    
    <main class="main-content">
        @Body
    </main>
</div>

@code {
    [Inject] private IAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    
    private bool _isDarkMode = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JSRuntime.InvokeAsync<string>("getTheme");
            _isDarkMode = theme == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        var newTheme = await JSRuntime.InvokeAsync<string>("toggleTheme");
        _isDarkMode = newTheme == "dark";
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
