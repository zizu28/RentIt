<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f9fafb; color: #1f2937; padding: 20px; }
        .container { max-width: 600px; margin: 0 auto; background: #ffffff; padding: 40px; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        .header { text-align: center; margin-bottom: 30px; }
        .logo { font-size: 28px; font-weight: 800; color: #111827; text-decoration: none; letter-spacing: -0.5px; }
        .content { font-size: 16px; line-height: 1.6; }
        h2 { color: #111827; font-weight: 700; margin-bottom: 20px; }
        .button { display: inline-block; background-color: #111827; color: #ffffff !important; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 600; margin-top: 20px; }
        .footer { margin-top: 40px; text-align: center; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb; padding-top: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <span class="logo">RentIt</span>
        </div>
        <div class="content">            <h2>Payment Receipt</h2>
            <p>Hi {{ Name }},</p>
            <p>We have successfully received your payment. Thank you!</p>
            <div style="background-color: #f3f4f6; padding: 15px; border-radius: 6px; margin: 20px 0;">
                <strong>Receipt Number:</strong> {{ ReceiptNumber }}<br>
                <strong>Date:</strong> {{ PaymentDate }}<br>
                <strong>Property:</strong> {{ PropertyAddress }}<br>
                <strong>Amount Paid:</strong> GHS {{ AmountFormatted }}
            </div>
            <p>Your booking is now confirmed. Please find the attached tenancy agreement for your records.</p>
            <div style="text-align: center;">
                <a href="{{ DashboardLink }}" class="button">View Dashboard</a>
            </div>        </div>
        <div class="footer">
            &copy; {{ CurrentYear }} RentIt. All rights reserved.
        </div>
    </div>
</body>
</html>
