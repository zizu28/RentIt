{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rentit-log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=RentIt_Identity;Trusted_Connection=True;MultipleActiveResultSets=true",
    "PropertiesDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=RentIt_Properties;Trusted_Connection=True;MultipleActiveResultSets=true",
    "BookingsDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=RentIt_Bookings;Trusted_Connection=True;MultipleActiveResultSets=true",
    "HangfireConnection": "Server=(localdb)\\MSSQLLocalDB;Database=RentIt_Hangfire;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JWT": {
    "Issuer": "RentIt",
    "Audience": "RentIt"
  },
  "Cloudinary": {
    "CloudName": "ddb1iwczm"
  },
  "SmtpSettings": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 2525,
    "Username": "your_mailtrap_username",
    "Password": "your_mailtrap_password",
    "FromEmail": "noreply@rentit.com",
    "FromName": "RentIt Properties"
  }
}
